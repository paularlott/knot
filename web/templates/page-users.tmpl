{{ template "layout-base.tmpl" . }}

{{ define "pageTitle" }}Users{{ end }}

{{ define "mainContent" }}
<main class="relative w-full h-full overflow-y-auto lg:ml-64 pb-8" x-data="userListComponent()">
  <div class="grid grid-cols-1 px-4 pt-6 xl:grid-cols-4 gap-2 xl:gap-4">

    <div class="col-span-full">
      <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">Users</h1>
    </div>

    <form class="app-toolbar col-span-full">
      <div>
        <label for="search" class="sr-only">Search</label>
        <div class="relative mt-1 sm:w-48 lg:w-64 xl:w-96 flex items-center">
          <input type="search" name="search" id="search" class="form-field grow pr-24 app-page-search" placeholder="Search" x-model="searchTerm" x-on:input="searchChanged" x-ref="searchInput">
          <button type="button" x-show="searchTerm" x-cloak @click="searchTerm=''; searchChanged(); $refs.searchInput.focus()" aria-label="Clear search" class="app-search-clear"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg></button><div class="app-search-shortcut" aria-hidden="true" data-shortcut="mod+k">⌘ K</div>
        </div>
      </div>
      <div>
        <button @click.prevent="createUser" class="btn-primary flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 mr-2" aria-hidden="true" >
            <path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
          </svg>
          New User
        </button>
      </div>
    </form>

    <div class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-xs col-span-full dark:border-gray-700 sm:p-6 dark:bg-gray-800">

      {{ template "loading" . }}
            <div x-show="!loading && users.length === 0" x-cloak>
        {{ template "empty" (map "heading" "No users yet" "text" "Users are the people who sign in to knot and run spaces." "action" "New User" "click" "createUser()") }}
      </div>
      <div x-show="!loading && users.length > 0" x-cloak class="relative overflow-x-auto sm:rounded-lg">
        <table aria-label="Users" class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
          <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-300 border-b dark:border-gray-700">
            <tr>
              {{ template "sort-th" (map "key" "name" "label" "User") }}
              {{ template "sort-th" (map "key" "status" "label" "Status" "class" "hidden 2xl:table-cell") }}
              {{ template "sort-th" (map "key" "spaces" "label" "Spaces" "class" "hidden md:table-cell") }}
              {{ template "sort-th" (map "key" "compute" "label" "Compute" "class" "hidden 2xl:table-cell") }}
              {{ template "sort-th" (map "key" "storage" "label" "Storage" "class" "hidden 2xl:table-cell") }}
              {{ if .filesEnabled }}{{ template "sort-th" (map "key" "files" "label" "Files" "class" "hidden 2xl:table-cell") }}{{ end }}
              {{ template "sort-th" (map "key" "tunnels" "label" "Tunnels" "class" "hidden 2xl:table-cell") }}
              <th scope="col" class="px-4 py-3 hidden lg:table-cell 2xl:hidden">Resources</th>
              <th scope="col" class="px-4 py-3 hidden xl:table-cell">Roles</th>
              <th scope="col" class="px-4 py-3 hidden xl:table-cell">Groups</th>
              {{ template "sort-th" (map "key" "login" "label" "Last Login" "class" "hidden xl:table-cell") }}
              <th scope="col" class="px-4 py-3 text-right">&nbsp;</th>
            </tr>
          </thead>
          <tbody>
            <template x-for="u in sorted(users)" :key="u.user_id">
              <tr x-show="!u.searchHide" class="group bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600/10">
                <!-- User Info Column - Always Visible -->
                <td class="px-4 py-3">
                  <div class="flex flex-col">
                    <div class="flex flex-row">
                      {{ if .useGravatar }}
                      <img :src="`https://www.gravatar.com/avatar/${MD5(u.email)}?s=64&d=mp`" alt="User Avatar" class="size-12 rounded-full mr-4">
                      {{ end }}
                      <div>
                        <div class="flex items-center">
                          <span class="font-medium text-gray-900 dark:text-white"><a :href="'/users?edit=' + encodeURIComponent(u.user_id)" class="table-name-link" @click="knotEditClick($event, () => editUser(u.user_id))"><span class="sr-only">Edit user </span><span x-text="u.username"></span></a></span>
                          <span x-show="u.active" class="2xl:hidden ml-2 app-badge-success">Active</span>
                          <span x-show="!u.active" class="2xl:hidden ml-2 app-badge-danger">Inactive</span>
                          <span x-show="u.has_linked_users" x-cloak class="2xl:hidden ml-2 app-badge-purple" title="This account has linked users it can switch to">Linked</span>
                        </div>
                        <div class="text-sm text-gray-500 dark:text-gray-400 truncate max-w-[180px]" x-text="u.email" :title="u.email"></div>
                      </div>
                    </div>

                    <!-- Mobile-only view of key metrics -->
                    <div class="flex flex-wrap gap-2 mt-2 lg:hidden">
                      <div class="app-badge-info md:hidden">
                        <span class="mr-1 font-medium">Spaces:</span>
                        <span x-text="u.number_spaces + (u.max_spaces ? ' / ' + u.max_spaces : '')"></span>
                        <span x-show="u.number_spaces_deployed > 0" x-cloak class="app-badge-success ml-2 whitespace-nowrap" x-text="u.number_spaces_deployed + ' deployed'"></span>
                      </div>
                      <div class="app-badge-purple">
                        <span class="mr-1 font-medium">Compute:</span>
                        <span x-text="u.used_compute_units + (u.compute_units ? ' / ' + u.compute_units : '')"></span>
                      </div>
                      <div class="app-badge-warning">
                        <span class="mr-1 font-medium">Storage:</span>
                        <span x-text="u.used_storage_units + (u.storage_units ? ' / ' + u.storage_units : '')"></span>
                      </div>
                      {{ if .filesEnabled }}
                      <div class="app-badge-info">
                        <span class="mr-1 font-medium">Files:</span>
                        <span x-text="(u.used_file_storage_mb || 0).toFixed(1) + ' MB' + (u.file_storage_mb ? ' / ' + u.file_storage_mb + ' MB' : '')"></span>
                      </div>
                      {{ end }}
                      <div class="app-badge-success">
                        <span class="mr-1 font-medium">Tunnels:</span>
                        <span x-text="u.used_tunnels + (u.max_tunnels ? ' / ' + u.max_tunnels : '')"></span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Status Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden 2xl:table-cell">
                  <span x-show="u.active" class="app-badge-success">Active</span>
                  <span x-show="!u.active" class="app-badge-danger">Inactive</span>
                  <div x-show="u.has_linked_users" x-cloak class="mt-1">
                    <span class="app-badge-purple" title="This account has linked users it can switch to">Linked</span>
                  </div>
                </td>

                <!-- Spaces Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden md:table-cell">
                  <div class="flex flex-col gap-1 text-xs">
                    <span x-text="u.number_spaces + (u.max_spaces ? ' / ' + u.max_spaces : '')"></span>
                    <span x-show="u.number_spaces_deployed > 0" x-cloak class="app-badge-success w-fit whitespace-nowrap" x-text="u.number_spaces_deployed + ' deployed'"></span>
                  </div>
                </td>

                <!-- Compute Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden 2xl:table-cell" x-text="u.used_compute_units + (u.compute_units ? ' / ' + u.compute_units : '')"></td>

                <!-- Storage Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden 2xl:table-cell" x-text="u.used_storage_units + (u.storage_units ? ' / ' + u.storage_units : '')"></td>

                {{ if .filesEnabled }}
                <!-- File Storage Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden 2xl:table-cell">
                  <div class="flex flex-col gap-1 text-xs">
                    <span class="whitespace-nowrap" x-text="(u.used_file_storage_mb || 0).toFixed(1) + ' MB' + (u.file_storage_mb ? ' / ' + u.file_storage_mb + ' MB' : '')"></span>
                    <span class="whitespace-nowrap" x-text="(u.used_buckets || 0) + (u.max_buckets ? ' / ' + u.max_buckets : '') + ' buckets'"></span>
                  </div>
                </td>
                {{ end }}

                <!-- Tunnels Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden 2xl:table-cell" x-text="u.max_tunnels ? u.max_tunnels : '-'"></td>

                <!-- Resources Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden lg:table-cell 2xl:hidden">
                  <div class="flex flex-col space-y-2">
                    <div class="inline-flex items-center text-xs py-1 text-nowrap">
                      <span class="mr-1 font-medium">Compute:</span>
                      <span x-text="u.used_compute_units + (u.compute_units ? ' / ' + u.compute_units : '')"></span>
                    </div>
                    <div class="inline-flex items-center text-xs py-1 text-nowrap">
                      <span class="mr-1 font-medium">Storage:</span>
                      <span x-text="u.used_storage_units + (u.storage_units ? ' / ' + u.storage_units : '')"></span>
                    </div>
                    {{ if .filesEnabled }}
                    <div class="inline-flex items-center text-xs py-1 text-nowrap">
                      <span class="mr-1 font-medium">Files:</span>
                      <span x-text="(u.used_file_storage_mb || 0).toFixed(1) + ' MB' + (u.file_storage_mb ? ' / ' + u.file_storage_mb + ' MB' : '')"></span>
                    </div>
                    {{ end }}
                    <div class="inline-flex items-center text-xs py-1 text-nowrap">
                      <span class="mr-1 font-medium">Tunnels:</span>
                      <span x-text="u.used_tunnels + (u.max_tunnels ? ' / ' + u.max_tunnels : '')"></span>
                    </div>
                  </div>
                </td>

                <!-- Roles Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden xl:table-cell">
                  <template x-if="u.role_names.length">
                    <div class="flex flex-col gap-1">
                      <template x-for="role in u.role_names">
                        <span class="app-badge-info whitespace-nowrap w-fit" x-text="role"></span>
                      </template>
                    </div>
                  </template>
                  <span x-show="!u.role_names.length">-</span>
                </td>

                <!-- Groups Column - Hidden on Mobile -->
                <td class="px-4 py-3 hidden xl:table-cell">
                  <template x-if="u.group_names.length">
                    <div class="flex flex-col gap-2">
                      <template x-for="group in u.group_names">
                        <span class="app-badge-warning whitespace-nowrap w-fit" x-text="group"></span>
                      </template>
                    </div>
                  </template>
                  <span x-show="!u.group_names.length" class="text-gray-500 dark:text-gray-400">-</span>
                </td>

                <!-- Last Login - Hidden on Small Screens -->
                <td class="px-4 py-3 hidden xl:table-cell text-nowrap text-xs" x-text="u.last_login_at"></td>

                <!-- Actions Column -->
                <td class="px-4 py-3 text-right">

                  <div class="inline-flex items-center" x-data>
                    <div class="hidden xl:flex items-center justify-end gap-2" aria-label="User actions">
                      <button x-show="u.number_spaces > 0" @click="userSpaces(u.user_id)" class="row-action-button row-action-primary" type="button" :aria-label="'View spaces for user ' + u.username" title="View spaces">
                        <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z" />
                        </svg>
                        <span class="sr-only">View spaces</span>
                      </button>
                      <button x-show="u.number_spaces_deployed_in_zone > 0" @click="confirmStop(u)" class="row-action-button row-action-danger" type="button" :aria-label="'Stop spaces for user ' + u.username" title="Stop spaces">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 0 1 9 14.437V9.564Z" />
                        </svg>
                        <span class="sr-only">Stop spaces</span>
                      </button>
                      <button @click="openUsage(u.user_id, u.username)" class="row-action-button row-action-primary" type="button" :aria-label="'Usage for user ' + u.username" title="Usage">
                        <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
                        </svg>
                        <span class="sr-only">Usage</span>
                      </button>
                      <button @click="editUser(u.user_id)" class="row-action-button" type="button" :aria-label="'Edit user ' + u.username" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                        </svg>
                        <span class="sr-only">Edit</span>
                      </button>
                      <button x-show="!u.current" @click="confirmDelete(u)" class="row-action-button row-action-danger" type="button" :aria-label="'Delete user ' + u.username" title="Delete">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                        <span class="sr-only">Delete</span>
                      </button>
                    </div>
                    <button @click="$refs.panel.toggle" class="row-action-menu-trigger xl:hidden" type="button" :aria-label="'More actions for user ' + u.username">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true" >
                        <path fill-rule="evenodd" d="M10.5 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm0 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm0 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z" clip-rule="evenodd" />
                      </svg><span class="sr-only">More</span>
                    </button>

                    <div x-ref="panel" x-float.teleport.placement.bottom-end.flip @click.away="$refs.panel.close" @keydown.window.escape="$refs.panel.close" class="fixed z-50 my-1 text-base p-2 list-none bg-white divide-y divide-gray-100 rounded-lg shadow-xl border border-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:divide-gray-600 block whitespace-nowrap xl:hidden" x-cloak>
                      <button @click="$refs.panel.close; openUsage(u.user_id, u.username)" class="group nav-item text-sm px-4 w-full">
                        <svg class="size-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
                        </svg> Usage
                      </button>
                      <button @click="$refs.panel.close; editUser(u.user_id)" class="group nav-item text-sm px-4 w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 mr-2" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                        </svg> Edit
                      </button>
                      <button x-show="u.number_spaces > 0" @click="userSpaces(u.user_id)" class="group nav-item text-sm px-4 w-full">
                        <svg class="size-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z" />
                        </svg> View Spaces
                      </button>

                      <hr x-show="!u.current" class="my-2" />
                      <button x-show="!u.current" @click="$refs.panel.close; confirmDelete(u)" class="group nav-item text-sm px-4 w-full text-red-700 hover:bg-red-50 hover:text-red-800 dark:text-red-400 dark:hover:bg-red-900/30 dark:hover:text-red-300">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 mr-2" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg> Delete
                      </button>

                      <hr x-show="u.number_spaces_deployed_in_zone > 0" class="my-2" />
                      <button x-show="u.number_spaces_deployed_in_zone > 0" @click="$refs.panel.close; confirmStop(u)" class="group nav-item text-sm px-4 w-full text-red-700 hover:bg-red-50 hover:text-red-800 dark:text-red-400 dark:hover:bg-red-900/30 dark:hover:text-red-300">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 mr-2" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 0 1 9 14.437V9.564Z" />
                        </svg> Stop Spaces
                      </button>
                    </div>
                  </div>

                </td>
              </tr>
            </template>
            {{ template "no-results" (map "list" "users" "things" "users" "cols" 13) }}
          </tbody>
        </table>
      </div>

      <!-- Modal create/edit user -->
      <div x-cloak x-show="userFormModal.show" x-transition.opacity.duration.200ms x-trap.inert.noscroll="userFormModal.show" @keydown.esc.window="userFormModal.show = false" class="ui-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="userModalTitle">
        <div x-show="userFormModal.show" x-transition:enter="transition ease-out duration-200 delay-100 motion-reduce:transition-opacity" x-transition:enter-start="scale-95 opacity-0" x-transition:enter-end="scale-100 opacity-100" class="ui-modal-panel-wide max-h-[90vh]" data-dirty-form>
          <div class="ui-modal-header">
            <div class="ui-modal-icon-info">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
            </div>
            <h3 id="userModalTitle" class="ui-modal-title" x-text="userFormModal.isEdit ? 'Edit User' : 'Create User'"></h3>
            <button @click="userFormModal.show = false" aria-label="close modal" class="ui-modal-close">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" fill="none" stroke-width="1.4" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <template x-if="userFormModal.show">
              {{ template "user-form-content" . }}
          </template>
        </div>
      </div>

      <!-- Modal: User Usage -->
      <div x-cloak x-show="usageModal.show" x-transition.opacity.duration.200ms x-trap.inert.noscroll="usageModal.show" @keydown.esc.window="usageModal.show = false" class="ui-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="usageModalTitle">
        <div x-show="usageModal.show" x-transition:enter="transition ease-out duration-200 delay-100 motion-reduce:transition-opacity" x-transition:enter-start="scale-95 opacity-0" x-transition:enter-end="scale-100 opacity-100" class="ui-modal-panel-2xl max-h-[90vh] flex flex-col">
          <div class="ui-modal-header">
            <div class="ui-modal-icon-info">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z" />
              </svg>
            </div>
            <h3 id="usageModalTitle" class="ui-modal-title" x-text="'Usage for ' + usageModal.username"></h3>
            <button @click="usageModal.show = false" aria-label="close modal" class="ui-modal-close">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" fill="none" stroke-width="1.4" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="ui-modal-body-scroll">
            <template x-if="usageModal.show">
              <div x-data="usageComponent(usageModal.userId, {{ .filesEnabled }})" x-effect="usageModal.show || destroy()">
                <div x-show="loading" class="text-sm text-gray-500 dark:text-gray-400 py-4" role="status">Loading &hellip;</div>
                <div x-show="!loading" x-cloak>
                  {{ template "usage-meters" . }}
                </div>
              </div>
            </template>
          </div>
        </div>
      </div>

    </div>

  </div>
</main>
{{ end }}
