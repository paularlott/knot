{{ define "group-form-content" }}
<div x-data="userGroupForm(groupFormModal.isEdit, groupFormModal.groupId)" x-init="initData()" class="contents">
  <div class="flex-1 min-h-0 overflow-y-auto p-5 relative">
  {{ template "loading" . }}
  <form class="space-y-6" x-show="!loading" x-cloak @submit.prevent="submitData">
    <fieldset class="rounded-lg p-4 border border-gray-200 dark:border-gray-700">
      <legend class="text-sm font-medium text-gray-900 dark:text-white px-2">General</legend>
      <div class="space-y-6">
        <div>
          <label for="name" class="form-label">Name</label>
          <input type="text" name="name" id="name" class="form-field" x-on:keyup.debounce.500ms="checkName()" :class="{'form-field-error': !nameValid}" :aria-invalid="!nameValid ? 'true' : 'false'" :aria-describedby="!nameValid ? 'name-error' : null" placeholder="Group name" x-model="formData.name">
          <div id="name-error" x-show="!nameValid" class="error-message" x-cloak>Group name can be a max 64 characters.</div>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label for="max_spaces" class="form-label">Maximum Spaces</label>
            <input type="number" class="form-field" name="max_spaces" id="max_spaces" x-model="formData.max_spaces" min="0" max="10000" x-on:keyup.debounce.500ms="checkMaxSpaces()" :class="{'form-field-error': !maxSpacesValid}" :aria-invalid="!maxSpacesValid ? 'true' : 'false'" :aria-describedby="!maxSpacesValid ? 'max_spaces-error' : null">
            <p class="description">The maximum number of spaces users of this group can create, 0 for unlimited.</p>
            <div id="max_spaces-error" x-show="!maxSpacesValid" class="error-message" x-cloak>Enter a valid number between 0 and 10,000.</div>
          </div>
          <div>
            <label for="max_tunnels" class="form-label">Maximum Tunnels</label>
            <input type="number" class="form-field" name="max_tunnels" id="max_tunnels" x-model="formData.max_tunnels" min="0" x-on:keyup.debounce.500ms="checkMaxTunnels()" :class="{'form-field-error': !maxTunnelsValid}" :aria-invalid="!maxTunnelsValid ? 'true' : 'false'" :aria-describedby="!maxTunnelsValid ? 'max_tunnels-error' : null">
            <p class="description">The maximum number of tunnels users of this group can use, 0 for unlimited.</p>
            <div id="max_tunnels-error" x-show="!maxTunnelsValid" class="error-message" x-cloak>Enter a valid number between 0 and 100.</div>
          </div>
          <div>
            <label for="compute_units" class="form-label">Compute Units Limit</label>
            <input type="number" class="form-field" name="compute_units" id="compute_units" x-model="formData.compute_units" min="0" x-on:keyup.debounce.500ms="checkComputeUnits()" :class="{'form-field-error': !computeUnitsValid}" :aria-invalid="!computeUnitsValid ? 'true' : 'false'" :aria-describedby="!computeUnitsValid ? 'compute_units-error' : null">
            <p class="description">The maximum number of compute units (CPU, GPU, RAM, etc.) users of this group can use, 0 for unlimited.</p>
            <div id="compute_units-error" x-show="!computeUnitsValid" class="error-message" x-cloak>Enter a valid number >= 0.</div>
          </div>
          <div>
            <label for="storage_units" class="form-label">Storage Units Limit</label>
            <input type="number" class="form-field" name="storage_units" id="storage_units" x-model="formData.storage_units" min="0" x-on:keyup.debounce.500ms="checkStorageUnits()" :class="{'form-field-error': !storageUnitsValid}" :aria-invalid="!storageUnitsValid ? 'true' : 'false'" :aria-describedby="!storageUnitsValid ? 'storage_units-error' : null">
            <p class="description">The maximum number of storage units users of this group can use, 0 for unlimited.</p>
            <div id="storage_units-error" x-show="!storageUnitsValid" class="error-message" x-cloak>Enter a valid number >= 0.</div>
          </div>
          <div>
            <label for="file_storage_mb" class="form-label">File Storage (MB)</label>
            <input type="number" class="form-field" name="file_storage_mb" id="file_storage_mb" x-model="formData.file_storage_mb" min="0" x-on:keyup.debounce.500ms="checkFileStorage()" :class="{'form-field-error': !fileStorageValid}" :aria-invalid="!fileStorageValid ? 'true' : 'false'" :aria-describedby="!fileStorageValid ? 'file_storage_mb-error' : null">
            <p class="description">The file storage, in MB, each user of this group adds to their quota, 0 for none.</p>
            <div id="file_storage_mb-error" x-show="!fileStorageValid" class="error-message" x-cloak>Enter a valid number >= 0.</div>
          </div>
          <div>
            <label for="max_buckets" class="form-label">Maximum Buckets</label>
            <input type="number" class="form-field" name="max_buckets" id="max_buckets" x-model="formData.max_buckets" min="0" x-on:keyup.debounce.500ms="checkMaxBuckets()" :class="{'form-field-error': !maxBucketsValid}" :aria-invalid="!maxBucketsValid ? 'true' : 'false'" :aria-describedby="!maxBucketsValid ? 'max_buckets-error' : null">
            <p class="description">The file storage buckets each user of this group adds to their limit, 0 for none.</p>
            <div id="max_buckets-error" x-show="!maxBucketsValid" class="error-message" x-cloak>Enter a valid number >= 0.</div>
          </div>
        </div>
      </div>
    </fieldset>
  </form>
  </div>
  <div class="ui-modal-footer">
    <button type="button" @click="groupFormModal.show = false" class="ui-button-secondary sm:mr-auto" x-text="isEdit ? 'Discard' : 'Cancel'"></button>
    <button type="submit" @click="submitData" class="btn-primary" :disabled="loading" x-text="isEdit ? 'Save' : 'Create'"></button>
  </div>
</div>
{{ end }}
