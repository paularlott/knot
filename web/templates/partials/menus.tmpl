{{ define "main-menu" }}
<nav aria-label="Main navigation">
  <ul class="pb-2 space-y-2" id="nav-main-list">

    {{/* Pinned (starred) items — Mode B only. Drag handle reorders the set. */}}
    {{ if .navModeB }}
      {{ range .navStarred }}
      <li class="nav-row nav-starred-item" draggable="true" data-nav-url="{{.URL}}">
        <span class="nav-drag-handle" aria-hidden="true">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="15" cy="18" r="1.4"/></svg>
        </span>
        <a href="{{.URL}}" class="nav-item flex-1 min-w-0" draggable="false">
          {{ .Icon }}
          <span class="ml-3 truncate">{{.Label}}</span>
        </a>
        <button type="button" class="nav-star-btn" data-nav-url="{{.URL}}" data-starred="true" aria-label="Unpin {{.Label}}" title="Remove from top">
          {{ template "nav-icon-star-filled" }}
        </button>
      </li>
      {{ end }}
    {{ end }}

    {{/* Default primary items — Mode A only (demote into More once a pin exists). */}}
    {{ if not .navModeB }}
      {{ range .navTop }}
      <li class="nav-row">
        <a href="{{.URL}}" class="nav-item flex-1 min-w-0" draggable="false">
          {{ .Icon }}
          <span class="ml-3 truncate">{{.Label}}</span>
        </a>
        <button type="button" class="nav-star-btn" data-nav-url="{{.URL}}" aria-label="Pin {{.Label}}" title="Pin to top">
          {{ template "nav-icon-star-outline" }}
        </button>
      </li>
      {{ end }}
    {{ end }}

    {{/* More section (renders whenever there is at least one non-pinned item). */}}
    {{ if .navMore }}
    <li x-data="{ moreOpen: {{ if .moreSectionActive }}true{{ else }}false{{ end }} }">
      <button type="button" @click="moreOpen = !moreOpen" class="nav-item w-full" :aria-expanded="moreOpen">
        <svg class="nav-item-icon shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <span class="ml-3 flex-1 text-left whitespace-nowrap">More</span>
        <svg class="size-4 text-gray-500 transition-transform duration-200" :class="{ 'rotate-90': moreOpen }" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" >
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </button>
      <ul x-show="moreOpen" {{ if not .moreSectionActive }}x-cloak{{ end }} class="mt-1 ml-4 space-y-2">
        {{ range .navMore }}
        <li class="nav-row">
          <a href="{{.URL}}" class="nav-item flex-1 min-w-0" draggable="false">
            {{ .Icon }}
            <span class="ml-3 truncate">{{.Label}}</span>
          </a>
          <button type="button" class="nav-star-btn" data-nav-url="{{.URL}}" aria-label="Pin {{.Label}}" title="Pin to top">
            {{ template "nav-icon-star-outline" }}
          </button>
        </li>
        {{ end }}
      </ul>
    </li>
    {{ end }}

  </ul>
</nav>
{{ end }}

{{ define "nav-icon-star-filled" }}<svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>{{ end }}

{{ define "nav-icon-star-outline" }}<svg class="size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>{{ end }}

