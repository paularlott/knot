{{/* Empty state for a list page.
     Call: {{ template "empty" (map "heading" "No groups yet" "text" "Groups set ..." "action" "New Group" "click" "createGroup()") }}
     "text", "action" and "click" are optional; pass "action" only when the viewer can create one,
     e.g. "action" (and .permissionManageGroups "New Group"). */}}
{{ define "empty" }}
<div class="app-empty">
  <div role="status">
    <h2 class="app-empty-heading">{{ .heading }}</h2>
    {{ with .text }}<p class="app-empty-text">{{ . }}</p>{{ end }}
  </div>
  {{ if .action }}
  <button type="button" class="btn-primary mt-4" @click="{{ .click }}">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" /></svg>
    {{ .action }}
  </button>
  {{ end }}
</div>
{{ end }}
