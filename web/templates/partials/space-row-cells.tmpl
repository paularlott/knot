                      <div x-show="s.is_local && s.is_deployed && s.resource_usage" x-cloak class="mt-3 max-w-md space-y-2 lg:hidden">
                        <button type="button" class="w-full text-left cursor-pointer" @click="openSpaceUsage(s.space_id)" :aria-label="'CPU ' + formatPercent(s.resource_usage?.cpu_percent || 0) + ', show usage of ' + s.name">
                          <div class="flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400">
