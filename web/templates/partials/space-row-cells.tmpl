                <!-- Actions: the main one (Start, or Stop) as a labelled button
                     from md up; everything else in the ⋮ menu. -->
                <td class="px-4 py-3 text-right">
                  <div x-data x-show="s.is_local || hasSpaceAccessForCurrentUser(s)" x-cloak class="flex items-center justify-end gap-2">
                    <div class="hidden md:flex items-center">
                    <button x-show="canStartStop(s) && spaceStatus(s) === 'stopped'" @click="startSpace(s.space_id)" class="row-action-labelled row-action-success" type="button" :aria-label="'Start ' + s.name">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z" /></svg>
                      <span>Start</span>
                    </button>
                    <button x-show="canStartStop(s) && (s.is_deployed || s.is_pending) && !s.is_deleting" :disabled="spaceStatus(s) === 'stopping'" @click="stopSpace(s.space_id)" class="row-action-labelled row-action-danger" type="button" :aria-label="(spaceStatus(s) === 'stopping' ? 'Stopping ' : 'Stop ') + s.name">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path d="M5.25 3A2.25 2.25 0 0 0 3 5.25v9.5A2.25 2.25 0 0 0 5.25 17h9.5A2.25 2.25 0 0 0 17 14.75v-9.5A2.25 2.25 0 0 0 14.75 3h-9.5Z" /></svg>
                      <span x-text="spaceStatus(s) === 'stopping' ? 'Stopping' : 'Stop'"></span>
                    </button>
                    <button x-show="canStartStop(s) && s.is_deployed && !s.is_pending" @click="restartSpace(s.space_id)" class="row-action-labelled ml-2" type="button" :aria-label="'Restart ' + s.name">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                      <span>Restart</span>
                    </button>
                    </div>

                    <button @click="$refs.panel.toggle($event)" class="row-action-menu-trigger" type="button" aria-expanded="false" :aria-label="'More actions for ' + s.name" :title="'More actions for ' + s.name">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true" >
                        <path fill-rule="evenodd" d="M10.5 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm0 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm0 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z" clip-rule="evenodd" />
                      </svg>
                    </button>

                    <div x-ref="panel" x-float.teleport.placement.bottom-end.flip @click.away="$refs.panel.close" class="fixed z-50 my-1 text-base p-2 list-none bg-white rounded-lg shadow-xl border border-gray-200 dark:bg-gray-800 dark:border-gray-700 block whitespace-nowrap min-w-44" x-cloak>
                      <!-- Start / Stop live in the row from md up -->
                      <button x-show="canStartStop(s) && spaceStatus(s) === 'stopped'" @click="$refs.panel.close(); startSpace(s.space_id)" class="group nav-item text-sm px-4 w-full md:hidden" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 mr-2" aria-hidden="true"><path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z" /></svg> Start
                      </button>
                      <button x-show="canStartStop(s) && (s.is_deployed || s.is_pending) && !s.is_deleting" :disabled="spaceStatus(s) === 'stopping'" @click="$refs.panel.close(); stopSpace(s.space_id)" class="group nav-item text-sm px-4 w-full md:hidden disabled:opacity-50" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 mr-2" aria-hidden="true"><path d="M5.25 3A2.25 2.25 0 0 0 3 5.25v9.5A2.25 2.25 0 0 0 5.25 17h9.5A2.25 2.25 0 0 0 17 14.75v-9.5A2.25 2.25 0 0 0 14.75 3h-9.5Z" /></svg> Stop
                      </button>
                      <button x-show="canStartStop(s) && s.is_deployed && !s.is_pending" @click="$refs.panel.close(); restartSpace(s.space_id)" class="group nav-item text-sm px-4 w-full md:hidden" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 mr-2" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg> Restart
                      </button>
                      <button x-show="!s.pool_id && s.user_id == forUserId && s.is_local" :disabled="s.is_pending" @click="$refs.panel.close(); editSpace(s.space_id)" class="group nav-item text-sm px-4 w-full disabled:opacity-50" type="button" :title="s.is_pending ? 'Wait until the space has started or stopped' : null">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 mr-2" aria-hidden="true" >
                          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                        </svg> Edit
                      </button>

                      {{ if .permissionUseVSCodeTunnel }}
                      <button x-show="!s.pool_id && s.user_id == forUserId && s.is_local && s.is_deployed && !s.is_pending && s.user_id == '{{ .user_id }}' && s.has_vscode_tunnel && s.vscode_tunnel_name.length" @click="$refs.panel.close(); openTerminalTunnel(s.space_id)" class="group nav-item text-sm px-4 w-full" type="button">
