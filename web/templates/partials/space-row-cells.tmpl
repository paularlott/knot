                            <button type="button" class="shrink-0 grow-0 ml-1 cursor-pointer rounded focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-500" @click.debounce.750="copyToClipboard(s.space_id)" aria-label="Copy space ID" title="Copy">
