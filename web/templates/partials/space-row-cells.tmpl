{{/* Row cells for one space in the spaces table (spaces.tmpl), used inside an
     element with x-data="{ s: space }". Columns: Space, Connect (md+),
     Status (lg+), Shared (2xl+), Template (xl+), Actions. */}}

{{/* The space's state: icon + text (never colour alone), then the start-up
     elapsed time, uptime or when it last started. */}}
{{ define "space-status" }}
<div class="flex items-center gap-x-2 gap-y-1 flex-wrap">
  <span class="inline-flex items-center gap-1 text-xs font-medium whitespace-nowrap" :class="statusClass(s)">
    <svg x-show="spaceStatus(s) === 'running'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
    <svg x-show="spaceStatus(s) === 'unhealthy'" x-cloak xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" /></svg>
    <svg x-show="spaceStatus(s) === 'starting' || spaceStatus(s) === 'stopping'" x-cloak class="size-4 shrink-0 animate-spin motion-reduce:animate-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
    <svg x-show="spaceStatus(s) === 'deleting'" x-cloak xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0" aria-hidden="true"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4Z" clip-rule="evenodd" /></svg>
    <svg x-show="spaceStatus(s) === 'stopped'" x-cloak xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 9.563C9 9.252 9.252 9 9.563 9h4.874c.311 0 .563.252.563.563v4.874c0 .311-.252.563-.563.563H9.564A.562.562 0 0 1 9 14.437V9.564Z" /></svg>
    <span x-text="statusLabel(s)"></span>
  </span>
  <span x-show="spaceStatus(s) === 'starting' && s.pending_since" x-cloak class="text-xs text-gray-500 dark:text-gray-400 tabular-nums whitespace-nowrap" x-text="startingElapsed(s)"></span>
  <span x-show="spaceStatus(s) === 'running' || spaceStatus(s) === 'unhealthy'" x-cloak class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap"><span class="sr-only">Up for </span><span aria-hidden="true">Up </span><span x-text="s.uptime"></span></span>
  <span x-show="spaceStatus(s) === 'stopped' && lastStartedText(s)" x-cloak class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap" x-text="'Last started ' + lastStartedText(s)"></span>
  <span x-show="s.is_local && s.update_available && !s.is_pending" x-cloak class="app-badge-purple whitespace-nowrap" title="The template has changed since this space started; restart it to use the new version">Update available</span>
</div>
{{ end }}

{{/* Ways to connect to a running space (desktop: its own column; mobile:
     under the name). Stopped and starting spaces say what to expect. */}}
{{ define "space-services" }}
  <!-- Running: connect buttons. Each tooltip opens on hover and focus, stays
       open while the pointer moves onto it, and closes on Escape. -->
  <template x-if="s.is_local && s.is_deployed && !s.is_pending && hasSpaceAccessForCurrentUser(s)">
    <div class="flex flex-wrap items-center gap-1">
      {{ if .permissionUseVNC }}
      <div x-show="s.has_http_vnc" x-data x-cloak class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
        <button type="button" @click="openWindowForVNC(s.username, s.space_id, s.name)" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" /></svg>
          <span class="sr-only">Desktop</span>
        </button>
        <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak>Desktop</div>
      </div>
      <div x-show="s.platform === 'kvm' && s.template_has_vnc" x-data x-cloak class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
        <button type="button" @click="openVMDisplay(s.space_id)" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25Z" /></svg>
          <span class="sr-only">VM Display</span>
        </button>
        <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak>VM Display</div>
      </div>
      {{ end }}
      {{ if .permissionUseCodeServer }}
      <div x-show="s.has_code_server" x-data x-cloak class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
        <button type="button" @click="openCodeServer(s.space_id)" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
          <span class="sr-only">Code Server</span>
        </button>
        <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak>Code Server</div>
      </div>
      {{ end }}
      {{ if .permissionUseVSCodeTunnel }}
      <div x-show="s.has_vscode_tunnel && !s.vscode_tunnel_name.length" x-data x-cloak class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
        <button type="button" @click="openTerminalTunnel(s.space_id)" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-red-600 dark:text-red-400" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
          <span class="sr-only">Connect VSCode Tunnel</span>
        </button>
        <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak>Connect VSCode Tunnel</div>
      </div>
      <div x-show="s.has_vscode_tunnel && s.vscode_tunnel_name.length" x-data x-cloak class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
        <button type="button" @click="openVSCodeDev(s.vscode_tunnel_name)" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
          <span class="sr-only">VSCode</span>
        </button>
        <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak>VSCode</div>
      </div>
      {{ end }}
      {{ if .permissionUseWebTerminal }}
      <div x-show="s.has_terminal" x-data x-cloak class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
        <button type="button" @click="openTerminal(s.space_id)" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
          <span class="sr-only">Terminal</span>
        </button>
        <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak>Terminal</div>
      </div>
      {{ end }}
      <!-- Single HTTP port -->
      <template x-if="(!s.tcp_ports || !Object.entries(s.tcp_ports).length) && (s.http_ports && Object.entries(s.http_ports).length == 1) && !(s.alt_names && s.alt_names.length)">
        <div x-data class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
          <button type="button" @click="openWindowForPort(s.username, s.space_id, s.pool_name || s.name, Object.entries(s.http_ports)[0][0])" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>
            <span class="sr-only" x-text="Object.entries(s.http_ports)[0][1]"></span>
          </button>
          <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak x-text="Object.entries(s.http_ports)[0][1]"></div>
        </div>
      </template>
      <!-- Several ports: a menu of them -->
      <template x-if="(s.tcp_ports && Object.entries(s.tcp_ports).length) || (s.http_ports && Object.entries(s.http_ports).length > 1) || (s.http_ports && Object.entries(s.http_ports).length && s.alt_names && s.alt_names.length)">
        <div x-data class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
          <button type="button" @click="tipHide($el.parentElement); $refs.panel.toggle($event)" aria-expanded="false" data-disclosure class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" >
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z" />
            </svg><span class="sr-only">Ports</span>
          </button>
          <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak>Ports</div>
          <div x-ref="panel" x-float.teleport.placement.bottom-end.flip @click.away="$refs.panel.close" class="fixed z-50 my-1 text-base p-2 list-none bg-white divide-y divide-gray-100 rounded-lg shadow-xl border border-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:divide-gray-600 block whitespace-nowrap" x-cloak>
            <template x-for="entry in getHttpPortEntries(s)" :key="entry.name + '-' + entry.key">
              <button type="button" x-text="entry.label" @click="$refs.panel.close(); openWindowForPort(s.username, s.space_id, entry.name, entry.key)" class="nav-item text-sm px-4 w-full"></button>
            </template>
            <hr x-show="Object.entries(s.http_ports || {}).length && Object.entries(s.tcp_ports || {}).length" class="my-2" role="separator" />
            <template x-for="[key, value] in Object.entries(s.tcp_ports || {})" :key="key">
              <div class="nav-item text-sm px-4 w-full hover:bg-transparent dark:hover:bg-transparent cursor-default"><span x-text="key==value ? key : value + ' (' + key + ')'"></span><span class="sr-only"> (TCP port)</span></div>
            </template>
          </div>
        </div>
      </template>
      {{ if .permissionUseLogs }}
      <div x-show="s.platform !== 'kvm' && (s.has_state || s.platform !== 'manual')" x-data x-cloak class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
        <button type="button" @click="openLogWindow(s.space_id)" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
          <span class="sr-only">Logs</span>
        </button>
        <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak>Logs</div>
      </div>
      {{ end }}
      <div x-show="s.has_jobs" x-data x-cloak class="relative" @mouseenter="tipShow($el)" @mouseleave="tipHide($el, 150)" @focusin="tipShow($el)" @focusout="tipHide($el)">
        <button type="button" @click="openJobs(s.space_id)" class="cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg p-1.5" :class="s.jobs_enabled ? 'text-emerald-600 dark:text-emerald-400' : 'text-gray-500 dark:text-gray-400'">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          <span class="sr-only" x-text="s.jobs_enabled ? 'Jobs (running)' : 'Jobs (stopped)'"></span>
        </button>
        <div x-ref="tooltip" x-float.placement.bottom.flip class="absolute z-50 my-1 px-2 py-1 text-xs text-white bg-gray-600 dark:bg-gray-900 rounded shadow-xs whitespace-nowrap" role="tooltip" x-cloak x-text="s.jobs_enabled ? 'Jobs (running)' : 'Jobs (stopped)'"></div>
      </div>
      <!-- Deployed but the agent hasn't connected yet -->
      <span x-show="!s.has_state && s.platform !== 'kvm' && s.platform !== 'manual'" x-cloak class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">Connecting&hellip;</span>
    </div>
  </template>

  <!-- Starting: the start-up log is available straight away -->
  <template x-if="s.is_local && spaceStatus(s) === 'starting' && hasSpaceAccessForCurrentUser(s)">
    <div class="flex flex-wrap items-center gap-2">
      {{ if .permissionUseLogs }}
      <button x-show="s.platform !== 'kvm'" type="button" @click="openLogWindow(s.space_id)" class="inline-flex items-center gap-1 rounded-lg px-1.5 py-1 text-xs font-medium text-blue-700 hover:bg-gray-100 hover:underline dark:text-blue-300 dark:hover:bg-gray-700 cursor-pointer whitespace-nowrap">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4" aria-hidden="true" ><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
        <span>View start-up log</span><span class="sr-only"> for <span x-text="s.name"></span></span>
      </button>
      {{ end }}
      <span class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">Ready to connect once started</span>
    </div>
  </template>

  <!-- Everything else: say why there's nothing to connect to -->
  <template x-if="!(s.is_local && s.is_deployed && !s.is_pending && hasSpaceAccessForCurrentUser(s)) && !(s.is_local && spaceStatus(s) === 'starting' && hasSpaceAccessForCurrentUser(s))">
