                            <div class="h-full rounded-full bg-blue-500" :style="`width: ${usagePercent(s.resource_usage?.cpu_percent || 0, 100)}%`"></div>
                          </div>
                        </button>
                        <button type="button" class="w-full text-left cursor-pointer" @click="openSpaceUsage(s.space_id)" :aria-label="'Memory ' + formatUsage(s.resource_usage?.memory_used_bytes || 0, s.resource_usage?.memory_limit_bytes || 0) + ', show usage of ' + s.name">
                          <div class="flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400">
                            <span>Memory</span>
