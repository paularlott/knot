                  <div x-show="s.is_local && s.is_deployed && s.resource_usage" x-cloak class="mt-2 grid grid-cols-2 gap-2 min-w-[9rem]">
                    <button type="button" class="w-full text-left cursor-pointer" @click="openSpaceUsage(s.space_id)" :aria-label="'CPU ' + formatPercent(s.resource_usage?.cpu_percent || 0) + ', show usage of ' + s.name">
                      <div class="flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400">
                        <span>CPU</span>
                        <span x-text="formatPercent(s.resource_usage?.cpu_percent || 0)"></span>
                      </div>
                      <div class="mt-0.5 h-1.5 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
                        <div class="h-full rounded-full bg-blue-500" :style="`width: ${usagePercent(s.resource_usage?.cpu_percent || 0, 100)}%`"></div>
                      </div>
                    </button>
                    <button type="button" class="w-full text-left cursor-pointer" @click="openSpaceUsage(s.space_id)" :aria-label="'Memory ' + formatPercent(usagePercent(s.resource_usage?.memory_used_bytes || 0, s.resource_usage?.memory_limit_bytes || 0)) + ', show usage of ' + s.name">
                      <div class="flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400">
                        <span>Mem</span>
                        <span x-text="formatPercent(usagePercent(s.resource_usage?.memory_used_bytes || 0, s.resource_usage?.memory_limit_bytes || 0))"></span>
                      </div>
                      <div class="mt-0.5 h-1.5 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
                        <div class="h-full rounded-full bg-emerald-500" :style="`width: ${usagePercent(s.resource_usage?.memory_used_bytes || 0, s.resource_usage?.memory_limit_bytes || 0)}%`"></div>
