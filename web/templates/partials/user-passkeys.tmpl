{{ define "partials/user-passkeys.tmpl" }}
{{ if .passkeysEnabled }}
{{/* A user's passkeys: anyone who can edit the user may remove them; only
     the user, on their own profile, may add one, through the Add Passkey
     dialog. */}}
<div x-show="isEdit" x-cloak x-data="userPasskeys(userFormModal.userId, {{ if .isProfile }}true{{ else }}false{{ end }}, '{{ .passkeyOrigin }}')">
  <fieldset class="rounded-lg p-4 border border-gray-200 dark:border-gray-700">
    <legend class="text-sm font-medium text-gray-900 dark:text-white px-2">Passkeys</legend>
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-3" x-show="isProfile">Sign in with your device's fingerprint, face, screen lock or a security key instead of a password and authenticator code.</p>
    <ul class="divide-y divide-gray-200 dark:divide-gray-700 rounded-lg border border-gray-200 dark:border-gray-700" x-show="passkeys.length > 0">
      <template x-for="pk in passkeys" :key="pk.passkey_id">
        <li class="flex items-center justify-between px-4 py-2.5 gap-4 text-sm text-gray-700 dark:text-gray-300">
          <div class="min-w-0">
            <div class="font-medium text-gray-900 dark:text-white truncate" x-text="pk.name"></div>
            <div class="text-xs text-gray-500 dark:text-gray-400">
              <span x-text="pk.backup_eligible ? 'Synced passkey' : 'Device-bound passkey'"></span>
              <span aria-hidden="true">&middot;</span>
              <span x-text="'Added ' + formatDate(pk.created_at)"></span>
              <span aria-hidden="true">&middot;</span>
              <span x-text="pk.last_used_at ? 'Last used ' + formatDate(pk.last_used_at) : 'Never used'"></span>
            </div>
          </div>
          <button type="button" @click="confirmRemove(pk)" class="group flex items-center cursor-pointer whitespace-nowrap rounded-lg bg-red-700 hover:bg-red-800 px-4 py-2 text-center text-sm font-medium tracking-wide text-neutral-100 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black active:opacity-100 active:outline-offset-0 dark:text-white dark:bg-red-600 dark:hover:bg-red-700 dark:focus-visible:outline-white" :aria-label="'Remove passkey ' + pk.name">Remove</button>
        </li>
      </template>
    </ul>
    <p class="text-sm text-gray-500 dark:text-gray-400" x-show="loaded && passkeys.length === 0">No passkeys.</p>

    {{ if .isProfile }}
    <div class="mt-3">
      <button type="button" class="ui-button-secondary" @click="openAdd($event)" x-show="!unavailable">Add Passkey</button>
      <p class="text-sm text-gray-500 dark:text-gray-400" x-show="unavailable" x-text="unavailable" x-cloak></p>
    </div>

    <!-- Modal: add a passkey. The browser's own prompt runs on top of it. -->
    <div x-cloak x-show="addModal" x-transition.opacity.duration.200ms x-trap.inert.noscroll="addModal" @keydown.esc.window="closeAdd()" class="ui-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="addPasskeyTitle" aria-describedby="addPasskeyDesc">
      <div x-show="addModal" x-transition:enter="transition ease-out duration-200 delay-100 motion-reduce:transition-opacity" x-transition:enter-start="scale-95 opacity-0" x-transition:enter-end="scale-100 opacity-100" class="ui-modal-panel">
        <div class="ui-modal-header">
          <div class="ui-modal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="size-6" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0 1 19.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 0 0 4.5 10.5a7.464 7.464 0 0 1-1.15 3.993m1.989 3.559A11.209 11.209 0 0 0 8.25 10.5a3.75 3.75 0 1 1 7.5 0c0 .527-.021 1.049-.064 1.565M12 10.5a14.94 14.94 0 0 1-3.6 9.75m6.633-4.596a18.666 18.666 0 0 1-2.485 5.33" />
            </svg>
          </div>
          <div>
            <h3 id="addPasskeyTitle" class="ui-modal-title">Add a Passkey</h3>
            <p id="addPasskeyDesc" class="mt-1 text-sm text-gray-600 dark:text-gray-400">Your browser will ask you to confirm with your fingerprint, face, screen lock or security key.</p>
          </div>
          <button type="button" @click="closeAdd()" aria-label="close dialog" class="ui-modal-close" :disabled="busy">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" fill="none" stroke-width="1.4" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="ui-modal-body">
          <label for="passkey-name" class="form-label">Passkey name</label>
          <input type="text" id="passkey-name" class="form-field" maxlength="64" x-model="newName" @keydown.enter.prevent="add()" :disabled="busy" aria-describedby="passkey-name-help">
          <p id="passkey-name-help" class="description">So you can tell your passkeys apart, e.g. the device or password manager it's saved in.</p>
          <p class="mt-4 text-sm text-gray-600 dark:text-gray-400" role="status" x-show="busy" x-cloak>Follow your browser's prompt to create the passkey.</p>
          <div role="alert" class="mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-900/30 dark:text-red-300" x-show="addError" x-text="addError" x-cloak></div>
        </div>
        <div class="ui-modal-footer">
          <button type="button" class="ui-button-secondary" @click="closeAdd()" :disabled="busy">Cancel</button>
          <button type="button" class="ui-button-primary" @click="add()" :disabled="busy" x-text="busy ? 'Waiting for your device…' : 'Create Passkey'"></button>
        </div>
      </div>
    </div>
    {{ end }}
  </fieldset>
</div>
{{ end }}
{{ end }}
