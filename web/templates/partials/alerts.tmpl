{{ define "alerts" }}
{{/* Toasts, raised with the window event show-alert {type, msg}: type is
     success, info, warning or error. Success and info notes leave after 8s,
     but wait while pointed at or focused so they can be read; warnings and
     errors stay until closed, so nothing that needs acting on slips away.
     Screen readers hear each one through the page's permanent live regions
     (knotAnnounce): errors and warnings at once, the rest politely. A toast
     inserted with its text already inside is often not read, so the toasts
     themselves are not live regions. At most four show; the oldest goes
     first. */}}
<div class="fixed bottom-2 left-1/2 -translate-x-1/2 px-3 w-full sm:w-auto sm:min-w-96 max-w-lg z-[60] flex flex-col gap-2"
     x-data="{
       toasts: [], nextId: 1,
       add(detail) {
         const type = ['success', 'info', 'warning', 'error'].includes(detail.type) ? detail.type : 'info';
         const t = { id: this.nextId++, type, msg: detail.msg || '', held: false, timer: null };
         this.toasts.push(t);
         while (this.toasts.length > 4) this.remove(this.toasts[0].id);
         this.arm(t);
         if (window.knotAnnounce) {
           const text = new DOMParser().parseFromString('<p>' + t.msg + '</p>', 'text/html').body.textContent;
           const prefix = { success: '', info: '', warning: 'Warning: ', error: 'Error: ' }[type];
           window.knotAnnounce(prefix + text, { assertive: this.sticky(t) });
         }
       },
       sticky(t) { return t.type === 'error' || t.type === 'warning'; },
       arm(t) {
         clearTimeout(t.timer);
         if (!this.sticky(t) && !t.held) t.timer = setTimeout(() => this.remove(t.id), 8000);
       },
       hold(t, on) { t.held = on; on ? clearTimeout(t.timer) : this.arm(t); },
       remove(id) {
         const i = this.toasts.findIndex((t) => t.id === id);
         if (i >= 0) { clearTimeout(this.toasts[i].timer); this.toasts.splice(i, 1); }
       },
     }"
     @show-alert.window="add($event.detail || {})">
  <template x-for="t in toasts" :key="t.id">
    <div class="flex items-start w-full p-4 text-gray-700 bg-white rounded-lg shadow-lg dark:text-gray-200 dark:bg-gray-800 border"
         :class="{
           'border-red-300 dark:border-red-800': t.type === 'error',
           'border-amber-300 dark:border-amber-800': t.type === 'warning',
           'border-gray-200 dark:border-gray-700': t.type === 'success' || t.type === 'info',
         }"
         @mouseenter="hold(t, true)" @mouseleave="hold(t, false)"
         @focusin="hold(t, true)" @focusout="hold(t, false)">
      <div class="inline-flex items-center justify-center shrink-0 w-8 h-8 rounded-lg"
           :class="{
             'text-green-700 bg-green-100 dark:bg-green-800 dark:text-green-100': t.type === 'success',
             'text-blue-700 bg-blue-100 dark:bg-blue-800 dark:text-blue-100': t.type === 'info',
             'text-amber-800 bg-amber-100 dark:bg-amber-800 dark:text-amber-100': t.type === 'warning',
             'text-red-700 bg-red-100 dark:bg-red-800 dark:text-red-100': t.type === 'error',
           }">
        <svg x-show="t.type === 'success'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6" aria-hidden="true">
          <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
        </svg>
        <svg x-show="t.type === 'info'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6" aria-hidden="true">
          <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 0 1 .67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 1 1-.671-1.34l.041-.022ZM12 9a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
        </svg>
        <svg x-show="t.type === 'warning'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
        </svg>
        <svg x-show="t.type === 'error'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm-1.72 6.97a.75.75 0 1 0-1.06 1.06L10.94 12l-1.72 1.72a.75.75 0 1 0 1.06 1.06L12 13.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L13.06 12l1.72-1.72a.75.75 0 1 0-1.06-1.06L12 10.94l-1.72-1.72Z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ms-3 me-2 self-center text-sm font-normal break-words min-w-0">
        <span class="sr-only" x-text="{ success: 'Success:', info: 'Note:', warning: 'Warning:', error: 'Error:' }[t.type]"></span>
        <span x-html="t.msg"></span>
      </div>
      <button @click="remove(t.id)" type="button" class="ms-auto -mx-1.5 -my-1.5 shrink-0 text-gray-600 hover:text-gray-900 rounded-lg p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8 dark:text-gray-300 dark:hover:text-white dark:hover:bg-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-600 dark:focus-visible:ring-blue-400" aria-label="Close notification">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </template>
</div>
{{ end }}
