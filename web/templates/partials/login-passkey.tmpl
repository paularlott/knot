{{ define "partials/login-passkey.tmpl" }}
{{ if .passkeysEnabled }}
{{/* Passkey sign-in: one full-width button, last in the list of ways to
     sign in above the email form. Hidden where the browser has no WebAuthn,
     or on an address other than the server's URL, where passkeys can't
     work. */}}
<button type="button" x-show="passkeySupported" x-cloak @click="passkeyLogin()" data-passkey-origin="{{ .passkeyOrigin }}"
        class="auth-provider-button"
        :class="passkeyBusy ? 'pointer-events-none opacity-80' : ''"
        :aria-disabled="passkeyBusy ? 'true' : null">
  <div class="auth-provider-icon-shell">
    <svg x-show="!passkeyBusy" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0 1 19.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 0 0 4.5 10.5a7.464 7.464 0 0 1-1.15 3.993m1.989 3.559A11.209 11.209 0 0 0 8.25 10.5a3.75 3.75 0 1 1 7.5 0c0 .527-.021 1.049-.064 1.565M12 10.5a14.94 14.94 0 0 1-3.6 9.75m6.633-4.596a18.666 18.666 0 0 1-2.485 5.33" />
    </svg>
    <svg x-show="passkeyBusy" class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
    </svg>
  </div>
  <span class="auth-provider-title" x-text="passkeyBusy ? 'Waiting for your passkey…' : 'Sign in with a passkey'"></span>
</button>
{{ end }}
{{ end }}
