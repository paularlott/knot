{{/* A sortable column header for list tables using components/sortable.js.
     Call: {{ template "sort-th" (map "key" "name" "label" "Name" "class" "hidden md:table-cell") }}
     "class" is optional. "sort" names a nested sort state when a page has more than one
     table, e.g. (map "sort" "fileSort" "key" "size" "label" "Size"). */}}
{{ define "sort-th" }}{{ $s := "" }}{{ if .sort }}{{ $s = printf "%s." .sort }}{{ end }}<th scope="col" class="px-4 py-3 {{ .class }}" :aria-sort="{{ $s }}ariaSort('{{ .key }}')"><button type="button" class="table-sort-button" @click="{{ $s }}sortBy('{{ .key }}', '{{ .label }}')">{{ .label }}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="table-sort-icon" :class="{{ $s }}sortIcon('{{ .key }}') !== 'none' && 'table-sort-icon-active'" aria-hidden="true"><path x-show="{{ $s }}sortIcon('{{ .key }}') === 'none'" fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .55.24l3.25 3.5a.75.75 0 1 1-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 0 1-1.1-1.02l3.25-3.5A.75.75 0 0 1 10 3Zm-3.76 9.2a.75.75 0 0 1 1.06.04l2.7 2.908 2.7-2.908a.75.75 0 1 1 1.1 1.02l-3.25 3.5a.75.75 0 0 1-1.1 0l-3.25-3.5a.75.75 0 0 1 .04-1.06Z" clip-rule="evenodd"/><path x-show="{{ $s }}sortIcon('{{ .key }}') === 'asc'" fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612L5.29 9.77a.75.75 0 0 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd"/><path x-show="{{ $s }}sortIcon('{{ .key }}') === 'desc'" fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .75.75v10.638l3.96-4.158a.75.75 0 1 1 1.08 1.04l-5.25 5.5a.75.75 0 0 1-1.08 0l-5.25-5.5a.75.75 0 1 1 1.08-1.04l3.96 4.158V3.75A.75.75 0 0 1 10 3Z" clip-rule="evenodd"/></svg></button></th>{{ end }}
