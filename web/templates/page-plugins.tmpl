{{ template "layout-base.tmpl" . }}

{{ define "pageTitle" }}Plugins{{ end }}

{{ define "mainContent" }}
<main class="relative w-full h-full overflow-y-auto lg:ml-64 pb-8" x-data="pluginsListComponent()">
  <div class="grid grid-cols-1 px-4 pt-6 xl:grid-cols-4 gap-2 xl:gap-4">

    <div class="col-span-full">
      <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">Plugins</h1>
    </div>

    <div class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-xs col-span-full dark:border-gray-700 sm:p-6 dark:bg-gray-800">
      {{ template "loading" . }}

      <div x-show="!loading" x-cloak>

        <template x-if="plugins.length === 0 && failed.length === 0">
          <div class="text-sm text-gray-500 dark:text-gray-400 py-8 text-center">
            No plugins loaded. Configure <code class="font-mono">server.plugins_path</code> and restart the server.
          </div>
        </template>

        <div class="space-y-4">
          <template x-for="plugin in plugins" :key="plugin.name">
            <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4">
              <div class="flex items-start gap-4">
                <template x-if="plugin.logo_light">
                  <div class="shrink-0">
                    <img :src="plugin.logo_light" alt="" class="h-10 w-10 rounded dark:hidden">
                    <img :src="plugin.logo_dark" alt="" class="h-10 w-10 rounded hidden dark:block">
                  </div>
                </template>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-semibold text-gray-900 dark:text-white" x-text="plugin.name"></span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">loaded</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400 font-mono" x-show="plugin.version" x-text="'v' + plugin.version"></span>
                  </div>
                  <div class="mt-1 text-sm text-gray-500 dark:text-gray-400" x-show="plugin.description" x-text="plugin.description"></div>

                  <div class="mt-3" x-show="plugin.permissions.length > 0">
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">Permissions</div>
                    <div class="flex flex-wrap gap-1">
                      <template x-for="perm in plugin.permissions" :key="perm.id">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 font-mono" x-text="perm.id"></span>
                      </template>
                    </div>
                  </div>

                  <div class="mt-3" x-show="plugin.menus.length > 0">
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">Menu items</div>
                    <div class="flex flex-wrap gap-1">
                      <template x-for="menu in plugin.menus" :key="menu.url">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">
                          <span x-text="menu.label"></span>
                          <span class="opacity-60 inline-flex items-center gap-1" x-show="menu.permission" x-cloak>
                            <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
                            <span x-text="menu.permission"></span>
                          </span>
                        </span>
                      </template>
                    </div>
                  </div>

                  <div class="mt-3" x-show="plugin.pages.length > 0">
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">Pages</div>
                    <div class="flex flex-wrap gap-1">
                      <template x-for="page in plugin.pages" :key="page.url">
                        <a :href="page.url" class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200 hover:underline">
                          <span class="font-mono" x-text="page.path"></span>
                          <span class="opacity-60 font-mono" x-text="'→ ' + page.handler + '()'"></span>
                          <span class="opacity-60 inline-flex items-center" x-show="page.permission" x-cloak>
                            <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
                          </span>
                        </a>
                      </template>
                    </div>
                  </div>

                  <div class="mt-3" x-show="plugin.mcp_tools && plugin.mcp_tools.length > 0">
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">MCP tools</div>
                    <div class="flex flex-wrap gap-1">
                      <template x-for="tool in plugin.mcp_tools" :key="tool.name">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200" :title="tool.description">
                          <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745 1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" /></svg>
                          <span class="font-mono" x-text="tool.name"></span>
                          <span class="opacity-60 font-mono" x-text="'(' + (tool.parameters || []).join(', ') + ')'" x-show="tool.parameters && tool.parameters.length"></span>
                          <span class="opacity-60" x-show="tool.permission" x-cloak x-text="tool.permission"></span>
                        </span>
                      </template>
                    </div>
                  </div>

                  <div class="mt-3" x-show="plugin.handlers && plugin.handlers.length > 0">
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">Handlers</div>
                    <div class="flex flex-wrap gap-1">
                      <template x-for="decl in plugin.handlers" :key="decl.handler">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200 font-mono">
                          <span x-text="decl.handler + '()'"></span>
                          <span class="opacity-60" x-show="decl.permission" x-cloak x-text="decl.permission"></span>
                        </span>
                      </template>
                    </div>
                  </div>

                  <div class="mt-3" x-show="plugin.field_handlers && plugin.field_handlers.length > 0">
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">Field handlers</div>
                    <div class="flex flex-wrap gap-1">
                      <template x-for="field in plugin.field_handlers" :key="field.id">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200">
                          <span x-text="field.label"></span>
                          <span class="opacity-60 font-mono" x-text="field.id"></span>
                        </span>
                      </template>
                    </div>
                  </div>

                  <div class="mt-3" x-show="plugin.libs && plugin.libs.length > 0">
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">Scriptling libs</div>
                    <div class="flex flex-wrap gap-1">
                      <template x-for="lib in plugin.libs" :key="lib.name">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-200">
                          <span x-text="lib.name + ' v' + lib.version"></span>
                        </span>
                      </template>
                    </div>
                  </div>

                  <div class="mt-3" x-show="plugin.peers && plugin.peers.length > 0">
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">Binary peers</div>
                    <div class="flex flex-wrap gap-1">
                      <template x-for="peer in plugin.peers" :key="peer.name">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium"
                          :class="peer.healthy ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'"
                          :title="peer.error || ''">
                          <span x-text="lib.name + ' v' + lib.version"></span>
                        </span>
                      </template>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </template>

          <template x-for="plugin in failed" :key="plugin.path">
            <div class="rounded-lg border border-red-200 dark:border-red-900 p-4">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-semibold text-gray-900 dark:text-white" x-text="plugin.name"></span>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">failed to load</span>
              </div>
              <div class="mt-1 text-sm text-red-700 dark:text-red-300" x-text="plugin.reason"></div>
              <div class="mt-1 text-xs text-gray-500 dark:text-gray-400 font-mono" x-text="plugin.path"></div>
            </div>
          </template>

          <template x-if="warnings.length > 0">
            <div class="rounded-lg border border-yellow-200 dark:border-yellow-900 p-4">
              <div class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-1">Warnings</div>
              <ul class="space-y-1">
                <template x-for="warning in warnings" :key="warning">
                  <li class="text-sm text-gray-600 dark:text-gray-300" x-text="warning"></li>
                </template>
              </ul>
            </div>
          </template>

        </div>
      </div>
    </div>
  </div>
</main>
{{ end }}
