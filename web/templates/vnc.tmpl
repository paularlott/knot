<!DOCTYPE html>
<html lang="en" style="height: 100%; overflow: hidden; position: fixed; width: 100%;">
<head>
	<title>VM {{ .spaceName }} Display</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content">
	<script>if(localStorage.getItem('_x_darkMode') !== 'false') { document.documentElement.classList.add('dark') }</script>
	<link rel="stylesheet" href="/assets/css/knot.css?_v={{ .assetVersion }}" />
	<style>
		html, body { margin: 0; height: 100%; background: #111; }
		body { display: flex; flex-direction: column; }
		#vnc-bar {
			flex: none; display: flex; align-items: center; gap: 0.75rem;
			padding: 0.4rem 0.75rem; background: #1a1a1a; border-bottom: 1px solid #2c2c2c;
			color: #9ca3af; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.8rem;
			user-select: none;
		}
		#vnc-bar .spacer { flex: 1 1 auto; }
		#vnc-res { font-variant-numeric: tabular-nums; }
		#vnc-scale {
			border: 1px solid #374151; border-radius: 0.375rem; background: transparent; color: #d1d5db;
			padding: 0.1rem 0.6rem; font: inherit; cursor: pointer;
		}
		#vnc-scale:hover { background: #262626; }
		/* noVNC fills this with its own flex/overflow wrapper around the canvas */
		#screen { flex: 1 1 auto; min-height: 0; }
		#vnc-status {
			position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
			color: #e5e7eb; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.95rem;
			text-align: center; padding: 2rem; background: #111; z-index: 10;
		}
	</style>
</head>
<body>
	<div id="vnc-bar">
		<span>KVM {{ .spaceName }} Display</span>
		<span class="spacer"></span>
		<span id="vnc-res"></span>
		<button id="vnc-scale" type="button"></button>
	</div>
	<div id="screen" data-space-id="{{ .spaceId }}"></div>
	<div id="vnc-status">Connecting to the VM's display…</div>

	<script type="module" src="/assets/js/vnc.js?_v={{ .assetVersion }}"></script>
</body>
</html>
