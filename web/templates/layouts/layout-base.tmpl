<!DOCTYPE html>
<html x-data="{ darkMode: $persist(true) }" :class="{ 'dark': darkMode }" lang="en">
  <head>
    {{ template "head-meta" . }}
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 font-nunito" x-data="{ sidebarOpen: false, wide: window.matchMedia('(min-width: 1024px)').matches }" x-init="window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { wide = e.matches; if (wide) sidebarOpen = false })">
    <a href="#main-content" onclick="return knotSkipToMain(event)" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:p-4 focus:bg-blue-700 focus:text-white focus:rounded-br-lg">Skip to main content</a>
    <div class="h-screen">

      <!-- Top Bar -->
      <header class="fixed z-50 w-full bg-white border-b border-grey-200 dark:bg-gray-800 dark:border-gray-700">
        <div class="px-3 py-3 lg:px-5 lg:pl-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <button @click="sidebarOpen = !sidebarOpen" :aria-expanded="sidebarOpen ? 'true' : 'false'" aria-controls="sidebar" aria-label="Toggle sidebar" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-500 rounded-lg text-sm p-2.5 lg:hidden cursor-pointer">
                <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                  <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10"/>
                </svg>
              </button>

              <a href="/" class="flex ml-2 md:mr-24 select-none">
                {{ if .logoURL }}
                <img src="{{ .logoURL }}" class="mr-4 h-11 {{ if .logoInvert }}dark:brightness-0 dark:invert{{ end }}" alt="Home">
                {{ else if .pluginLogoLight }}
                <img src="{{ .pluginLogoLight }}" alt="Home" class="mr-4 h-11 dark:hidden">
                <img src="{{ .pluginLogoDark }}" alt="Home" class="mr-4 h-11 hidden dark:block">
                {{ else }}
                <img src="images/logo.svg" class="h-8 mr-3" alt="">
                <span class="self-center text-xl font-semibold sm:text-2xl whitespace-nowrap dark:text-white">knot</span>
                {{ end }}
              </a>
            </div>
            <div class="flex items-center">
              <!-- Search everything (the palette is for mouse and keyboard;
                   touch screens use each page's own search). -->
              <button type="button" x-data @click="$dispatch('open-search-palette')" data-shortcut-title="mod+shift+k" data-shortcut-label="Search everything" class="hidden md:inline-flex [@media(pointer:coarse)]:hidden items-center gap-2 mr-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white cursor-pointer" aria-keyshortcuts="Shift+Meta+K Shift+Control+K Shift+Alt+K">
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                <span>Search</span>
                <kbd class="kbd-key hidden lg:inline-flex px-1.5 text-sm tracking-wider" aria-hidden="true" data-shortcut="mod+shift+k">⌘ ⇧ K</kbd>
              </button>
              {{ if .switchBackUser }}
              <!-- Fast user switching: the session is running as another account —
                   make that unmissable and keep the way back one click away. -->
              <button type="button" onclick="knotSwitchUser('{{ .switchBackUser.Id }}')" title="You are switched into {{ .username }} — click to switch back to {{ .switchBackUser.Username }}" class="mr-2 app-badge-warning cursor-pointer hover:border-amber-400 dark:hover:border-amber-400/70">
                <svg class="size-3.5 mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                </svg><span class="hidden md:inline">Switched from {{ .switchBackUser.Username }}</span>
              </button>
              {{ end }}
              <!-- Live updates: pausing stops the page changing by itself (held
                   changes are applied on resume). -->
              <button type="button" x-data @click="knotLive.toggle()" :aria-pressed="$store.live && $store.live.paused ? 'true' : 'false'" aria-label="Pause live updates" :title="$store.live && $store.live.paused ? 'Live updates paused — click to resume' : 'Pause live updates'" class="relative mr-1 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-500 rounded-lg text-sm p-2.5 cursor-pointer" :class="{ 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200': $store.live && $store.live.paused }">
                <svg x-show="!($store.live && $store.live.paused)" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9v6m-4.5 0V9M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                <svg x-show="$store.live && $store.live.paused" x-cloak class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 0 1 0 .656l-5.603 3.113a.375.375 0 0 1-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112Z" /></svg>
                <span x-show="$store.live && $store.live.paused && $store.live.held" x-cloak class="absolute -top-1 -right-1 min-w-5 rounded-full bg-amber-700 px-1 text-xs font-semibold text-white" x-text="$store.live ? $store.live.held : ''"></span>
                <span class="sr-only" x-show="$store.live && $store.live.paused && $store.live.held" x-text="$store.live ? '(' + $store.live.held + ' changes waiting)' : ''"></span>
              </button>
              <button @click="darkMode = !darkMode; $dispatch('theme-change', {dark_theme: darkMode})" aria-label="Toggle dark mode" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-500 rounded-lg text-sm p-2.5 cursor-pointer">
                <svg x-show="!darkMode" class="w-5 h-5"  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" >
                  <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd" />
                </svg>
                <svg x-show="darkMode" class="w-5 h-5" x-cloak xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" >
                  <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.758 17.303a.75.75 0 0 0-1.061-1.06l-1.591 1.59a.75.75 0 0 0 1.06 1.061l1.591-1.59ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.697 7.757a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 0 0-1.061 1.06l1.59 1.591Z" />
                </svg>
              </button>

              <div class="ml-2 relative" x-data>
                <button @click="$refs.userMenu.toggle" type="button" class="group flex items-center border {{ if .switchBackUser }}border-amber-400/80 dark:border-amber-500/60 text-amber-700 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-500/10{{ else }}border-grey-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700{{ end }} focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-500 rounded-lg text-sm p-2.5 cursor-pointer" aria-expanded="false" aria-label="{{ if .switchBackUser }}User menu — switched from {{ .switchBackUser.Username }}{{ else }}User menu{{ end }}">
                  {{ if .useGravatar }}
                  <img src="https://www.gravatar.com/avatar/{{ .user_email_md5 }}?s=64&d=mp" alt="User Avatar" class="size-5 rounded-full mr-2">
                  {{ else }}
                  <svg class="w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" >
                    <path fill-rule="evenodd" d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
                  </svg>
                  {{ end }}
                  {{ .username }}
                </button>

                <div x-ref="userMenu" x-float.teleport.placement.bottom-end.flip @click.away="$refs.userMenu.close" x-cloak class="fixed z-50 my-1 text-base p-2 list-none bg-white divide-y divide-gray-100 rounded-lg shadow-xl border border-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:divide-gray-600 block whitespace-nowrap">
                  {{ template "menu-user" . }}
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="flex pt-16 overflow-hidden">

        <!-- Side Menu -->
        <aside :class="{'translate-x-0': sidebarOpen, '-translate-x-full': !sidebarOpen}" id="sidebar" @keydown.escape="sidebarOpen = false" :inert="!wide && !sidebarOpen" class="fixed top-0 left-0 z-20 flex flex-col shrink-0 w-64 h-full pt-16 font-normal duration-75 lg:flex transition-width lg:translate-x-0" aria-label="Sidebar">
          <div class="relative flex flex-col flex-1 min-h-0 pt-0 bg-white border-r border-gray-200 dark:bg-gray-800 dark:border-gray-700">
            <div class="flex flex-col flex-1 pt-5 pb-4 overflow-y-auto">
              <div class="flex-1 px-3 space-y-1 bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                {{ template "main-menu" . }}

                <div class="pt-2 space-y-2">
                  {{ template "main-menu2" . }}
                </div>
              </div>
            </div>
            <div class="px-4 mb-2 grow-0 shrink-0">
              <div class="mt-2 text-sm text-center text-gray-500 dark:text-gray-400">
                {{ if .clusterMode }}
                zone: {{ .zone }}<br />
                {{ end }}
                v{{ .version }}
              </div>
            </div>
          </div>
        </aside>
        <div :class="{'block': sidebarOpen, 'hidden': !sidebarOpen}" @click="sidebarOpen = false" @keydown.escape="sidebarOpen = false" class="fixed inset-0 z-10 bg-gray-900/50 dark:bg-gray-900/90 lg:hidden" aria-hidden="true"></div>

        <!-- Main Content -->
        <div id="main-content" class="contents">
        {{ block "mainContent" . }}{{ end }}
        </div>

      </div>

    </div>

{{ template "alerts" . }}

{{ template "session-warning" . }}

{{ template "chat" . }}

{{ template "search-palette" . }}

{{ template "confirm-dialog" . }}

  </body>
</html>
