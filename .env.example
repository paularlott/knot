# knot integration test harness configuration (integration-tests/suites).
# The harness boots its own server + spaces; nothing here points at a
# shared deployment.

# Local container runtime for spaces: docker | apple
KNOT_TEST_RUNTIME=docker

# Registry cache prefix for image pulls. Set to pull through a cache,
# e.g. hub.anaconda.ovh/docker — images then reference
# <cache>/<namespace>/<image>. Empty/unset pulls direct from Docker Hub.
KNOT_TEST_DOCKER_CACHE=

# Base image details
KNOT_TEST_IMAGE_NAMESPACE=paularlott
KNOT_TEST_IMAGE=knot-ubuntu:26.04

# Host address handed to spaces for the agent endpoint / server URL.
# Empty = let the knot server pick its own IP (the ${{ host_ip }} token
# resolves to the primary physical interface at server startup), which
# works on every runtime. Set only to override, e.g. host.docker.internal
# or a specific interface IP.
KNOT_TEST_CONTAINER_HOST=

# Zone name for test servers
KNOT_TEST_ZONE=core

# Set to 1 to keep servers, data dirs and containers after a run for
# debugging (spaces/containers are still deleted via the API).
KNOT_TEST_KEEP=0

# Stream server logs to test output
KNOT_TEST_VERBOSE_SERVER=0

# Skip `task build` (use existing bin/knot)
KNOT_TEST_NO_BUILD=0

# Seconds to wait for a space agent to boot (default 600)
#KNOT_TEST_SPACE_READY_TIMEOUT=600

# --- legacy suites (scripts_integration_test.go etc.) ---------------------
# These run against a shared server; uncomment and fill to use them.
#KNOT_BASE_URL=https://knot.example.com
#KNOT_ZONE=core
#KNOT_USER1_TOKEN=
#KNOT_USER2_TOKEN=
